# Local Android SMS Gateway — OTP configuration (pilot, NOT production enabled)
# Copy to private deployment environment. Never commit populated secrets.
OTP_PROVIDER=android_gateway
OTP_ENABLED=false
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_PHONE_HOUR=5
OTP_MAX_REQUESTS_PER_IP_HOUR=20
OTP_SESSION_ACCESS_TTL_SECONDS=900
OTP_SESSION_REFRESH_TTL_DAYS=30
OTP_DEFAULT_COUNTRY_CODE=967
OTP_GATEWAY_POLL_SECONDS=5
OTP_GATEWAY_HEARTBEAT_SECONDS=30
OTP_GATEWAY_OFFLINE_AFTER_SECONDS=300
OTP_GATEWAY_SIM_POLICY=round_robin
OTP_GATEWAY_SIM_SEND_GAP_MS=3000
OTP_GATEWAY_MAX_RETRIES=3
OTP_GATEWAY_REQUIRE_DEVICE_SIGNATURE=true
OTP_GATEWAY_DEVICE_PUBLIC_KEY_PEM=
OTP_GATEWAY_SERVER_BASE_URL=
OTP_GATEWAY_DEVICE_ID=
# Existing FIN08 auth verifier must trust the OTP identity service's public key.
# AUTH_PUBLIC_KEY_PEM, AUTH_ISSUER and AUTH_AUDIENCE are separately required.
