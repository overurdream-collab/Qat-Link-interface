# EXAMPLE ONLY — NOT VALID CREDENTIALS. Never commit identity.runtime.env.
# Explicitly confirm these existing networks from the local read-only inventory.
FIN25_DOCKER_NETWORK=fin25-test-net
FIN08_DOCKER_NETWORK=maqwatilink_internal
IDENTITY_LOOPBACK_PORT=8090

# Dedicated identity_app connection. Database owner secrets are stored ONLY in identity.db.env.
IDENTITY_DATABASE_URL=postgresql://identity_app:REPLACE_WITH_SEPARATE_RUNTIME_PASSWORD@identity-db:5432/maqwati_identity

# All values below must be provisioned privately on the host, not from chat.
# FIN08 / user sessions: must match FIN08 AUTH_PUBLIC_KEY_PEM, AUTH_ISSUER, AUTH_AUDIENCE.
# Existing PUBLIC keys cannot be used to recover PRIVATE keys. Never paste keys into chat.
# If the matching private key is unavailable, STOP and plan coordinated trust rotation.
IDENTITY_PRIVATE_KEY_PEM=REPLACE_WITH_FIN08_TRUSTED_PRIVATE_RSA_KEY_ESCAPED_NEWLINES
IDENTITY_PUBLIC_KEY_PEM=REPLACE_WITH_FIN08_AUTH_PUBLIC_KEY_PEM_ESCAPED_NEWLINES
IDENTITY_ISSUER=REPLACE_WITH_FIN08_AUTH_ISSUER
IDENTITY_AUDIENCE=REPLACE_WITH_FIN08_AUTH_AUDIENCE

# FIN25 service proof: distinct trust profile from FIN08.
# Must match FIN25 JWT_PUBLIC_KEY_PEM, JWT_ISSUER and JWT_AUDIENCE exactly.
FIN25_SIGNING_PRIVATE_KEY_PEM=REPLACE_WITH_FIN25_TRUSTED_PRIVATE_RSA_KEY_ESCAPED_NEWLINES
FIN25_SIGNING_PUBLIC_KEY_PEM=REPLACE_WITH_FIN25_JWT_PUBLIC_KEY_PEM_ESCAPED_NEWLINES
FIN25_SIGNING_ISSUER=REPLACE_WITH_FIN25_JWT_ISSUER
FIN25_SIGNING_AUDIENCE=REPLACE_WITH_FIN25_JWT_AUDIENCE

# Internal container-to-container paths, NOT public trycloudflare addresses.
FIN25_INTERNAL_PROOF_URL=http://otp:8083/v1/internal/otp/proof
FIN25_INTERNAL_API_KEY=REPLACE_WITH_MATCHING_OTP_INTERNAL_API_KEY
FIN08_INTERNAL_BASE_URL=http://api:8080/

# Optional per-account finance proxy budgets (requests per minute).
# Defaults: reads 120, writes 20. A distributed edge limiter is still required.
IDENTITY_FINANCE_READ_PER_MINUTE=120
IDENTITY_FINANCE_WRITE_PER_MINUTE=20
