# EXAMPLE ONLY — NOT VALID CREDENTIALS. Never commit identity.runtime.env.
# Explicitly confirm these existing networks from the local read-only inventory.
FIN25_DOCKER_NETWORK=REPLACE_WITH_EXISTING_FIN25_NETWORK
FIN08_DOCKER_NETWORK=REPLACE_WITH_EXISTING_FIN08_NETWORK
IDENTITY_LOOPBACK_PORT=8090

# Dedicated identity_app connection. Database owner secrets are stored ONLY in identity.db.env.
IDENTITY_DATABASE_URL=postgresql://identity_app:REPLACE_WITH_SEPARATE_RUNTIME_PASSWORD@identity-db:5432/maqwati_identity

# All values below must be provisioned privately on the host, not from chat.
# Identity keys must be generated securely and RSA public key must match
# JWT_PUBLIC_KEY_PEM (FIN25) and AUTH_PUBLIC_KEY_PEM (FIN08).
IDENTITY_PRIVATE_KEY_PEM=REPLACE_WITH_PRIVATE_RSA_PKCS8_PEM_ESCAPED_NEWLINES
IDENTITY_PUBLIC_KEY_PEM=REPLACE_WITH_PUBLIC_RSA_PEM_ESCAPED_NEWLINES
IDENTITY_ISSUER=REPLACE_WITH_EXISTING_FIN25_AND_FIN08_ISSUER
IDENTITY_AUDIENCE=REPLACE_WITH_EXISTING_FIN25_AND_FIN08_AUDIENCE

# Internal container-to-container paths, NOT public trycloudflare addresses.
FIN25_INTERNAL_PROOF_URL=http://REPLACE_FIN25_OTP_CONTAINER:8083/v1/internal/otp/proof
FIN25_INTERNAL_API_KEY=REPLACE_WITH_MATCHING_OTP_INTERNAL_API_KEY
FIN08_INTERNAL_BASE_URL=http://REPLACE_FIN08_CONTAINER:8080/
