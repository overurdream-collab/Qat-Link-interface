# Isolated integration smoke-test proxy — NOT a live or public gateway.
# Bind inside Docker only. DO NOT publish this port to host or tunnel.
# Upstream identity:8090 was verified reachable from Caddy on fin25-test-net.
:8080 {
  @identity path /healthz /v1/identity/me /v1/identity/session
  handle @identity {
    reverse_proxy identity:8090
  }

  # Keep OTP unavailable from this test proxy until auth and abuse controls are approved.
  @otp path /v1/auth/otp/request /v1/auth/otp/verify
  handle @otp {
    respond "OTP access is not enabled in this isolated proxy" 403
  }

  # Do not expose administrative enrollment, finance, or internal proof endpoints.
  respond 404
}
